      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git push*)",
      "PowerShell(git pull*)",
      "PowerShell(git rebase*)",
      "PowerShell(python -m pipeline.*)",
      "PowerShell(cd C:\\workspace\\ai-daily-news*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
