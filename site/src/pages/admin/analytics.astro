---
// 관리자 전용 방문자 통계. 나비게이션에 링크하지 않음(비공개 URL).
// GoatCounter API를 브라우저에서 직접 호출 — API 토큰은 이 브라우저의
// localStorage에만 저장되고 저장소·빌드 산출물에는 절대 포함되지 않는다
// (public repo이므로 커밋되는 값은 전부 공개된다는 전제 하의 설계).
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>방문자 통계 (관리자) — AI Daily News</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@700;900&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-white text-ink antialiased">
    <main class="max-w-3xl mx-auto px-4 py-10">
      <header class="mb-8 pb-4 border-b-2 border-ink">
        <div class="text-[11px] tracking-[0.18em] uppercase font-bold text-accent mb-2">Admin Only</div>
        <h1 class="font-serif text-3xl font-black text-ink">방문자 통계</h1>
        <p class="mt-2 text-[13px] text-ink/60 leading-relaxed">
          GoatCounter API를 이 브라우저에서 직접 호출합니다. 사이트 코드·API 토큰은 이 브라우저의
          localStorage에만 저장되며 저장소나 서버로는 전혀 전송되지 않습니다 — 토큰을 아는 사람만
          데이터를 볼 수 있습니다.
        </p>
      </header>

      <section id="unlock" class="mb-8 border border-ink/15 p-5">
        <div class="text-[11px] tracking-[0.18em] uppercase font-bold text-ink/50 mb-3">연결</div>
        <div class="grid sm:grid-cols-2 gap-3 mb-3">
          <label class="block">
            <span class="block text-[12px] text-ink/60 mb-1">GoatCounter 사이트 코드</span>
            <input
              id="gc-site"
              type="text"
              placeholder="mycode (mycode.goatcounter.com)"
              autocomplete="off"
              class="w-full border border-ink/25 px-2.5 py-2 text-[13px] font-mono focus:outline-none focus:border-accent"
            />
          </label>
          <label class="block">
            <span class="block text-[12px] text-ink/60 mb-1">API 토큰 (읽기 전용 권장)</span>
            <input
              id="gc-token"
              type="password"
              placeholder="Bearer token"
              autocomplete="off"
              class="w-full border border-ink/25 px-2.5 py-2 text-[13px] font-mono focus:outline-none focus:border-accent"
            />
          </label>
        </div>
        <div class="flex items-center gap-2 flex-wrap">
          <button id="gc-save" class="px-4 py-2 bg-ink text-white text-[12px] font-semibold uppercase tracking-wide hover:bg-accent transition-colors">저장하고 불러오기</button>
          <button id="gc-clear" class="px-4 py-2 border border-ink/25 text-[12px] font-semibold uppercase tracking-wide text-ink/60 hover:border-accent hover:text-accent transition-colors">초기화</button>
          <span id="gc-status" class="text-[12px] text-ink/50"></span>
        </div>
      </section>

      <section id="dashboard" class="hidden">
        <div class="flex items-center justify-between mb-5 flex-wrap gap-2">
          <div class="flex gap-1.5" role="group" aria-label="기간 선택">
            <button data-days="7" class="gc-range px-3 py-1.5 text-[12px] font-semibold border border-ink/25 hover:border-accent">7일</button>
            <button data-days="30" class="gc-range px-3 py-1.5 text-[12px] font-semibold border border-ink/25 hover:border-accent">30일</button>
            <button data-days="90" class="gc-range px-3 py-1.5 text-[12px] font-semibold border border-ink/25 hover:border-accent">90일</button>
          </div>
          <span id="gc-updated" class="text-[11px] text-ink/40"></span>
        </div>

        <div id="gc-error" class="hidden mb-5 border border-accent/40 bg-accent/5 px-4 py-3 text-[13px] text-accent"></div>

        <div class="grid grid-cols-3 gap-4 mb-8">
          <div class="border-l-2 border-ink/15 pl-3">
            <div class="text-[11px] tracking-[0.18em] uppercase font-bold text-ink/50 mb-0.5">순방문자</div>
            <div id="gc-total-visitors" class="font-serif text-2xl font-black tabular-nums leading-none text-ink">—</div>
          </div>
          <div class="border-l-2 border-ink/15 pl-3">
            <div class="text-[11px] tracking-[0.18em] uppercase font-bold text-ink/50 mb-0.5">페이지뷰</div>
            <div id="gc-total-pageviews" class="font-serif text-2xl font-black tabular-nums leading-none text-ink">—</div>
          </div>
          <div class="border-l-2 border-ink/15 pl-3">
            <div class="text-[11px] tracking-[0.18em] uppercase font-bold text-ink/50 mb-0.5">기간</div>
            <div id="gc-range-label" class="font-serif text-2xl font-black tabular-nums leading-none text-accent">—</div>
          </div>
        </div>

        <div class="grid sm:grid-cols-2 gap-x-8 gap-y-8">
          <div>
            <h2 class="text-[11px] tracking-[0.18em] uppercase font-bold text-ink/50 mb-3">인기 페이지</h2>
            <ul id="gc-pages" class="space-y-1.5"></ul>
          </div>
          <div>
            <h2 class="text-[11px] tracking-[0.18em] uppercase font-bold text-ink/50 mb-3">유입 경로 (리퍼러)</h2>
            <ul id="gc-refs" class="space-y-1.5"></ul>
          </div>
          <div>
            <h2 class="text-[11px] tracking-[0.18em] uppercase font-bold text-ink/50 mb-3">국가</h2>
            <ul id="gc-locations" class="space-y-1.5"></ul>
          </div>
          <div>
            <h2 class="text-[11px] tracking-[0.18em] uppercase font-bold text-ink/50 mb-3">브라우저 / OS</h2>
            <ul id="gc-browsers" class="space-y-1.5"></ul>
          </div>
        </div>
      </section>
    </main>

    <script>
      const LS_SITE = "gc_admin_site";
      const LS_TOKEN = "gc_admin_token";

      const unlockSection = document.getElementById("unlock")!;
      const dashboardSection = document.getElementById("dashboard")!;
      const siteInput = document.getElementById("gc-site") as HTMLInputElement;
      const tokenInput = document.getElementById("gc-token") as HTMLInputElement;
      const saveBtn = document.getElementById("gc-save")!;
      const clearBtn = document.getElementById("gc-clear")!;
      const statusEl = document.getElementById("gc-status")!;
      const errorEl = document.getElementById("gc-error")!;
      const updatedEl = document.getElementById("gc-updated")!;
      const rangeLabelEl = document.getElementById("gc-range-label")!;

      let currentDays = 30;

      function getCreds(): { site: string; token: string } | null {
        try {
          const site = localStorage.getItem(LS_SITE);
          const token = localStorage.getItem(LS_TOKEN);
          return site && token ? { site, token } : null;
        } catch {
          return null;
        }
      }

      function saveCreds(site: string, token: string) {
        try {
          localStorage.setItem(LS_SITE, site);
          localStorage.setItem(LS_TOKEN, token);
        } catch {
          /* localStorage 불가 환경 — 세션 동안만 동작 */
        }
      }

      function clearCreds() {
        try {
          localStorage.removeItem(LS_SITE);
          localStorage.removeItem(LS_TOKEN);
        } catch {}
        dashboardSection.classList.add("hidden");
        siteInput.value = "";
        tokenInput.value = "";
        statusEl.textContent = "";
      }

      function showError(msg: string) {
        errorEl.textContent = msg;
        errorEl.classList.remove("hidden");
      }
      function hideError() {
        errorEl.classList.add("hidden");
        errorEl.textContent = "";
      }

      function renderBars(container: HTMLElement, items: Array<{ label: string; value: number }>) {
        container.innerHTML = "";
        if (!items.length) {
          const li = document.createElement("li");
          li.className = "text-[12px] text-ink/40";
          li.textContent = "데이터 없음";
          container.appendChild(li);
          return;
        }
        const max = Math.max(1, ...items.map((i) => i.value));
        for (const i of items) {
          const li = document.createElement("li");
          li.className = "flex items-center gap-2.5 text-[12px]";

          const label = document.createElement("span");
          label.className = "w-32 shrink-0 truncate text-ink/70";
          label.title = i.label;
          label.textContent = i.label;

          const track = document.createElement("span");
          track.className = "flex-1 h-3 bg-ink/8 rounded-sm overflow-hidden";
          const fill = document.createElement("span");
          fill.className = "block h-full rounded-sm";
          fill.style.width = Math.max(2, (i.value / max) * 100) + "%";
          fill.style.background = "#be1622";
          track.appendChild(fill);

          const value = document.createElement("span");
          value.className = "w-12 text-right tabular-nums font-semibold text-ink/70";
          value.textContent = i.value.toLocaleString("ko-KR");

          li.appendChild(label);
          li.appendChild(track);
          li.appendChild(value);
          container.appendChild(li);
        }
      }

      function apiUrl(site: string, path: string) {
        return `https://${site}.goatcounter.com/api/v0/${path}`;
      }

      async function fetchJson(url: string, token: string) {
        const res = await fetch(url, { headers: { Authorization: `Bearer ${token}` } });
        if (!res.ok) {
          const err: any = new Error(`HTTP ${res.status}`);
          err.status = res.status;
          throw err;
        }
        return res.json();
      }

      function roundedHourISO(d: Date) {
        const x = new Date(d);
        x.setMinutes(0, 0, 0);
        return x.toISOString();
      }

      async function loadStats(days: number) {
        const creds = getCreds();
        if (!creds) return;
        currentDays = days;
        hideError();
        document.querySelectorAll<HTMLButtonElement>(".gc-range").forEach((b) => {
          const active = Number(b.dataset.days) === days;
          b.classList.toggle("border-accent", active);
          b.classList.toggle("text-accent", active);
        });
        rangeLabelEl.textContent = `최근 ${days}일`;

        const end = new Date();
        const start = new Date(end.getTime() - days * 24 * 60 * 60 * 1000);
        const qs = `start=${encodeURIComponent(roundedHourISO(start))}&end=${encodeURIComponent(roundedHourISO(end))}&limit=15`;

        try {
          const [total, hits, refs, locations, browsers] = await Promise.all([
            fetchJson(apiUrl(creds.site, `stats/total?${qs}`), creds.token),
            fetchJson(apiUrl(creds.site, `stats/hits?${qs}`), creds.token),
            fetchJson(apiUrl(creds.site, `stats/toprefs?${qs}`), creds.token),
            fetchJson(apiUrl(creds.site, `stats/locations?${qs}`), creds.token),
            fetchJson(apiUrl(creds.site, `stats/browsers?${qs}`), creds.token),
          ]);

          document.getElementById("gc-total-visitors")!.textContent = (total.total || 0).toLocaleString("ko-KR");
          const pageviews = (hits.hits || []).reduce((sum: number, h: any) => sum + (h.count || 0), 0);
          document.getElementById("gc-total-pageviews")!.textContent = pageviews.toLocaleString("ko-KR");

          renderBars(
            document.getElementById("gc-pages")!,
            (hits.hits || []).map((h: any) => ({ label: h.path || "(root)", value: h.count || 0 }))
          );
          renderBars(
            document.getElementById("gc-refs")!,
            (refs.stats || []).map((r: any) => ({ label: r.name || "(직접 방문)", value: r.count || 0 }))
          );
          renderBars(
            document.getElementById("gc-locations")!,
            (locations.stats || []).map((l: any) => ({ label: l.name || "(알 수 없음)", value: l.count || 0 }))
          );
          renderBars(
            document.getElementById("gc-browsers")!,
            (browsers.stats || []).map((b: any) => ({ label: b.name || "(알 수 없음)", value: b.count || 0 }))
          );

          dashboardSection.classList.remove("hidden");
          updatedEl.textContent = `갱신 ${new Date().toLocaleTimeString("ko-KR", { hour: "2-digit", minute: "2-digit" })}`;
        } catch (e: any) {
          if (e && (e.status === 401 || e.status === 403)) {
            showError("토큰이 유효하지 않습니다. 사이트 코드/토큰을 다시 확인해 주세요.");
          } else {
            showError(
              `데이터를 불러오지 못했습니다 (${e?.message || "네트워크 오류"}). 사이트 코드가 정확한지, 토큰 권한이 통계 읽기를 포함하는지 확인해 주세요.`
            );
          }
        }
      }

      saveBtn.addEventListener("click", () => {
        const site = siteInput.value
          .trim()
          .replace(/^https?:\/\//, "")
          .replace(/\.goatcounter\.com.*$/, "");
        const token = tokenInput.value.trim();
        if (!site || !token) {
          statusEl.textContent = "사이트 코드와 토큰을 모두 입력하세요.";
          return;
        }
        saveCreds(site, token);
        statusEl.textContent = "";
        loadStats(currentDays);
      });

      clearBtn.addEventListener("click", clearCreds);

      document.querySelectorAll<HTMLButtonElement>(".gc-range").forEach((btn) => {
        btn.addEventListener("click", () => loadStats(Number(btn.dataset.days)));
      });

      const existing = getCreds();
      if (existing) {
        siteInput.value = existing.site;
        tokenInput.value = existing.token;
        loadStats(currentDays);
      }
    </script>
  </body>
</html>
